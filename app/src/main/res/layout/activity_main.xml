<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <Button android:id="@+id/tabFarm" style="@style/TabBtn" android:text="🐔 Ферма" />
        <Button android:id="@+id/tabRaffles" style="@style/TabBtn" android:text="🎟 Розыгрыши" />
        <Button android:id="@+id/tabSpam" style="@style/TabBtn" android:text="💬 Спам" />
        <Button android:id="@+id/tabCrash" style="@style/TabBtn" android:text="📈 Crash" />
        <Button android:id="@+id/tabStatus" style="@style/TabBtn" android:text="⚙ Статус" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp">

            <include layout="@layout/panel_farm" android:id="@+id/panelFarm" />
            <include layout="@layout/panel_raffles" android:id="@+id/panelRaffles" />
            <include layout="@layout/panel_spam" android:id="@+id/panelSpam" />
            <include layout="@layout/panel_crash" android:id="@+id/panelCrash" />
            <include layout="@layout/panel_status" android:id="@+id/panelStatus" />
        </FrameLayout>
    </ScrollView>
</LinearLayout>
