<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView style="@style/CardLabel" android:text="Telegram · публичный канал @promo_runs" android:layout_marginTop="0dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="После подключения отдельно запускайте проверку старых публикаций за выбранный период и мониторинг новых публикаций."
        android:textColor="@color/textDim" android:textSize="12sp" />

    <TextView style="@style/CardLabel" android:text="Telegram API ID" />
    <EditText android:id="@+id/promoApiId" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="number" android:singleLine="true" android:textColor="@color/text" android:background="@color/card" android:padding="10dp" />

    <TextView style="@style/CardLabel" android:text="Telegram API Hash" />
    <EditText android:id="@+id/promoApiHash" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text" android:background="@color/card" android:padding="10dp" />

    <TextView style="@style/CardLabel" android:text="Номер телефона Telegram" />
    <EditText android:id="@+id/promoPhone" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="phone" android:singleLine="true" android:textColor="@color/text" android:background="@color/card" android:padding="10dp" />

    <TextView style="@style/CardLabel" android:text="Зеркало для активации (выбирается вручную)" />
    <Spinner android:id="@+id/promoMirror" android:layout_width="match_parent" android:layout_height="48dp" />

    <TextView style="@style/CardLabel" android:text="Период проверки истории (дней)" />
    <EditText android:id="@+id/promoScanDays" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="number" android:singleLine="true" android:hint="Например, 365"
        android:textColor="@color/text" android:background="@color/card" android:padding="10dp" />

    <TextView style="@style/CardLabel" android:text="Интервал между активациями (секунд)" />
    <EditText android:id="@+id/promoActivationInterval" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="number" android:singleLine="true" android:hint="Например, 1"
        android:textColor="@color/text" android:background="@color/card" android:padding="10dp" />

    <Button android:id="@+id/promoStartBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Сохранить настройки и подключить Telegram" android:layout_marginTop="10dp" />

    <Button android:id="@+id/promoScanBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Начать проверку промо" android:layout_marginTop="6dp" />
    <Button android:id="@+id/promoMonitorBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Начать мониторинг" android:layout_marginTop="6dp" />

    <Button android:id="@+id/promoScanStopBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Остановить проверку истории" android:layout_marginTop="6dp" />

    <Button android:id="@+id/promoClearHistoryBtn" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Удалить историю использованных промо" android:layout_marginTop="6dp" />

    <TextView style="@style/CardLabel" android:text="Код входа Telegram" />
    <EditText android:id="@+id/promoLoginCode" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="number" android:singleLine="true" android:textColor="@color/text" android:background="@color/card" android:padding="10dp" />
    <Button android:id="@+id/promoSubmitCodeBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Подтвердить код" />

    <TextView style="@style/CardLabel" android:text="Пароль двухэтапной аутентификации (если запрошен)" />
    <EditText android:id="@+id/promoPassword" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textPassword" android:singleLine="true" android:textColor="@color/text" android:background="@color/card" android:padding="10dp" />
    <Button android:id="@+id/promoSubmitPasswordBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Подтвердить пароль" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/promoStopBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Остановить мониторинг" />
    </LinearLayout>

    <TextView android:id="@+id/promoStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Остановлено" android:textColor="@color/textDim" android:layout_marginTop="8dp" />
    <TextView style="@style/CardLabel" android:text="Результаты активации · выберите окно" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/promoResultsActivatedBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Активированы" android:textSize="10sp" />
        <Button android:id="@+id/promoResultsDepositBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Депозит" android:textSize="10sp" />
        <Button android:id="@+id/promoResultsUsedBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Уже использованы" android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/promoResultsInvalidBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Неверные / истекшие" android:textSize="10sp" />
        <Button android:id="@+id/promoResultsOtherBtn" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Другие причины" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/promoResultsTitle" style="@style/CardLabel" android:text="Активированные промокоды" />
    <TextView android:id="@+id/promoResultsList" style="@style/LogText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="12" android:ellipsize="end" android:text="Пока нет результатов." />
    <TextView style="@style/CardLabel" android:text="Найденные коды и результаты активации" />
    <TextView android:id="@+id/promoLog" style="@style/LogText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="12" android:ellipsize="end" android:text="" />
</LinearLayout>
