<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppButton" parent="Widget.Material3.Button">\n        <item name="android:layout_height">48dp</item>\n        <item name="android:minHeight">48dp</item>\n        <item name="android:insetTop">0dp</item>\n        <item name="android:insetBottom">0dp</item>\n        <item name="android:insetLeft">0dp</item>\n        <item name="android:insetRight">0dp</item>\n        <item name="cornerRadius">14dp</item>\n        <item name="android:textAllCaps">false</item>\n        <item name="android:textStyle">bold</item>\n        <item name="android:letterSpacing">0</item>\n    </style>\n    <style name="TabBtn" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:backgroundTint">@color/card</item>
        <item name="android:paddingLeft">2dp</item>\n        <item name="android:paddingRight">2dp</item>\n        <item name="android:paddingTop">4dp</item>\n        <item name="android:paddingBottom">4dp</item>\n        <item name="android:insetLeft">0dp</item>\n        <item name="android:insetRight">0dp</item>\n        <item name="android:textAllCaps">false</item>
    </style>
    <style name="CardLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
